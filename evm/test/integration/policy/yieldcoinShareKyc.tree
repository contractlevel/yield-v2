YieldcoinShare_kycPolicy
├── transfer
│   ├── when the recipient is not KYC approved
│   │   └── it should revert through ACE
│   ├── when the caller is not KYC approved
│   │   └── it should revert through ACE
│   └── when the accounts are KYC approved
│       └── it should transfer shares
├── batchTransfer
│   ├── when any recipient is not KYC approved
│   │   └── it should revert through ACE
│   ├── when the caller is not KYC approved
│   │   └── it should revert through ACE
│   └── when the accounts are KYC approved
│       └── it should transfer shares to all recipients
├── transferFrom
│   ├── when the recipient is not KYC approved
│   │   └── it should revert through ACE
│   └── when the accounts are KYC approved
│       └── it should transfer shares
├── approve
│   ├── when the spender is not KYC approved
│   │   └── it should revert through ACE
│   ├── when the caller is not KYC approved
│   │   └── it should revert through ACE
│   └── when the accounts are KYC approved
│       └── it should set allowance
├── increaseAllowance
│   ├── when the spender is not KYC approved
│   │   └── it should revert through ACE
│   ├── when the caller is not KYC approved
│   │   └── it should revert through ACE
│   └── when the accounts are KYC approved
│       └── it should increase allowance
└── decreaseAllowance
    ├── when the caller is not KYC approved
    │   └── it should revert through ACE
    └── when the caller is KYC approved
        └── it should decrease allowance
